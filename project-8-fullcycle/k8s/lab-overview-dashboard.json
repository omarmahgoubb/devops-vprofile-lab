{
  "uid": "lab-overview",
  "title": "Lab overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["lab"],
  "panels": [
    {"id": 10, "type": "stat", "title": "Master CPU utilisation", "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-master\"}))"}]},
    {"id": 11, "type": "stat", "title": "Master RAM utilisation", "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * max((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-master\"})"}]},
    {"id": 12, "type": "stat", "title": "Master disk utilisation", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * max((1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-master\"})"}]},
    {"id": 13, "type": "stat", "title": "Worker CPU utilisation", "gridPos": {"h": 4, "w": 8, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-worker\"}))"}]},
    {"id": 14, "type": "stat", "title": "Worker RAM utilisation", "gridPos": {"h": 4, "w": 8, "x": 8, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * max((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-worker\"})"}]},
    {"id": 15, "type": "stat", "title": "Worker disk utilisation", "gridPos": {"h": 4, "w": 8, "x": 16, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "min": 0, "max": 100, "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * max((1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})) * on(instance) group_left(nodename) node_uname_info{nodename=\"vm-vprofile-worker\"})"}]},
    {"id": 1, "type": "table", "title": "Nodes", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "Ready"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Not ready", "color": "red"}, "1": {"text": "Ready", "color": "green"}}}]}]}, {"matcher": {"id": "byName", "options": "CPU %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "min", "value": 0}, {"id": "max", "value": 100}]}, {"matcher": {"id": "byName", "options": "RAM %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "min", "value": 0}, {"id": "max", "value": 100}]}, {"matcher": {"id": "byName", "options": "Disk %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "gradient"}}, {"id": "min", "value": 0}, {"id": "max", "value": 100}]}]}, "options": {"showHeader": true, "cellHeight": "md", "sortBy": [{"displayName": "Node", "desc": false}]}, "targets": [{"refId": "A", "instant": true, "format": "table", "expr": "label_replace(kube_node_status_condition{condition=\"Ready\",status=\"true\"}, \"nodename\", \"$1\", \"node\", \"(.*)\")"}, {"refId": "B", "instant": true, "format": "table", "expr": "100 * (1 - avg by (nodename) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * on(instance) group_left(nodename) node_uname_info))"}, {"refId": "C", "instant": true, "format": "table", "expr": "100 * avg by (nodename) ((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(nodename) node_uname_info)"}, {"refId": "D", "instant": true, "format": "table", "expr": "100 * avg by (nodename) ((1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})) * on(instance) group_left(nodename) node_uname_info)"}], "transformations": [{"id": "joinByField", "options": {"byField": "nodename", "mode": "outer"}}, {"id": "filterFieldsByName", "options": {"include": {"names": ["nodename", "Value #A", "Value #B", "Value #C", "Value #D"]}}}, {"id": "organize", "options": {"renameByName": {"nodename": "Node", "Value #A": "Ready", "Value #B": "CPU %", "Value #C": "RAM %", "Value #D": "Disk %"}}}]},
    {"id": 2, "type": "stat", "title": "Pods running", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0, "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "sum(kube_pod_status_phase{phase=\"Running\"})"}]},
    {"id": 3, "type": "stat", "title": "Pod restarts in the last hour", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "round(sum(increase(kube_pod_container_status_restarts_total[1h])))"}]},
    {"id": 4, "type": "stat", "title": "Worker RAM used", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0, "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "100 * max((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(nodename) node_uname_info{nodename=~\".*worker.*\"})"}]},
    {"id": 6, "type": "stat", "title": "Pods not running", "description": "Pending, Failed, or Unknown. Finished jobs are not counted.", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"graphMode": "none", "colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}, "targets": [{"refId": "A", "instant": true, "expr": "sum(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"}) OR on() vector(0)"}]},
    {"id": 7, "type": "table", "title": "Restarted in the last hour", "description": "Empty means no pod restarted.", "gridPos": {"h": 7, "w": 24, "x": 0, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}, "options": {"showHeader": true, "cellHeight": "sm"}, "targets": [{"refId": "A", "instant": true, "format": "table", "expr": "round(sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h]))) > 0"}], "transformations": [{"id": "filterFieldsByName", "options": {"include": {"names": ["namespace", "pod", "Value"]}}}, {"id": "organize", "options": {"renameByName": {"namespace": "Namespace", "pod": "Pod", "Value": "Restarts"}}}]},
    {"id": 5, "type": "table", "title": "Apps", "description": "Login site, database, Memcached, RabbitMQ, and Jenkins.", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 27}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"decimals": 0}, "overrides": [{"matcher": {"id": "byName", "options": "Running"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Running", "color": "green"}}}]}]}, {"matcher": {"id": "byName", "options": "CPU"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 2}]}, {"matcher": {"id": "byName", "options": "RAM"}, "properties": [{"id": "unit", "value": "bytes"}]}, {"matcher": {"id": "byName", "options": "Limit"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "noValue", "value": "no limit"}]}, {"matcher": {"id": "byName", "options": "Started"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}]}]}, "options": {"showHeader": true, "cellHeight": "md"}, "targets": [{"refId": "A", "instant": true, "format": "table", "expr": "max by (app) (label_replace(kube_pod_status_phase{phase=\"Running\",namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}, \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\"))"}, {"refId": "B", "instant": true, "format": "table", "expr": "sum by (app) (label_replace(rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\",namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}[5m]), \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\"))"}, {"refId": "C", "instant": true, "format": "table", "expr": "sum by (app) (label_replace(container_memory_working_set_bytes{container!=\"\",container!=\"POD\",namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}, \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\"))"}, {"refId": "D", "instant": true, "format": "table", "expr": "sum by (app) (label_replace(kube_pod_container_status_restarts_total{namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}, \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\"))"}, {"refId": "E", "instant": true, "format": "table", "expr": "sum by (app) (label_replace(kube_pod_container_resource_limits{resource=\"memory\",namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}, \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\"))"}, {"refId": "F", "instant": true, "format": "table", "expr": "max by (app) (label_replace(kube_pod_start_time{namespace=~\"vprofile|jenkins\",pod=~\"^(app01|db01|mc01|rmq01|jenkins)-[a-z0-9]{8,10}-[a-z0-9]{5}$\"}, \"app\", \"$1\", \"pod\", \"(app01|db01|mc01|rmq01|jenkins)-.*\")) * 1000"}], "transformations": [{"id": "joinByField", "options": {"byField": "app", "mode": "outer"}}, {"id": "filterFieldsByName", "options": {"include": {"names": ["app", "Value #A", "Value #B", "Value #C", "Value #D", "Value #E", "Value #F"]}}}, {"id": "organize", "options": {"renameByName": {"app": "App", "Value #A": "Running", "Value #B": "CPU", "Value #C": "RAM", "Value #D": "Restarts", "Value #E": "Limit", "Value #F": "Started"}}}]}
  ]
}
